# Perfil Oracle para el MVP. La instancia Oracle debe existir fuera de Docker
# (Oracle 19c/21c/23ai, servicio/PDB accesible desde el backend).
DB_ENGINE=oracle
ORACLE_HOST=oracle.example.local
ORACLE_PORT=1521
ORACLE_SERVICE_NAME=FREEPDB1
ORACLE_USER=INVENTARIO
ORACLE_PASSWORD=CHANGE_ME

# No se requieren variables POSTGRES_* para este perfil.
SECRET_KEY=CHANGE_ME_MIN_32_CHARACTERS
FIELD_ENCRYPTION_KEY=CHANGE_ME
REDIS_URL=redis://:CHANGE_ME@redis:6379/0
REFRESH_TOKEN_EXPIRE_DAYS=30
SESSION_ABSOLUTE_MAX_HOURS=720
SESSION_IDLE_TIMEOUT_MINUTES=43200
REFRESH_COOKIE_PERSISTENT=true

ENVIRONMENT=development
SEED_DEMO=true
